{
    "name": "laravel/keja",
    "type": "project",
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "authors": [
        {
            "name": "Homes4077",
            "email": "liljaymar254@gmail.com"
        }
    ],
    "require": {
        "laravel/framework": "^13.34"
    },
    "repositories": [{
        "name": "packagist",
        "type": "composer",
        "url": "https://repo.packagist.org"
    }],
    "require-dev": {
        "laravel/pail": "^1.2",
        "laravel/breeze": "^2.4",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0",
        "mockery/mockery": "^1.6",
        "fakerphp/faker": "^1.24"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
